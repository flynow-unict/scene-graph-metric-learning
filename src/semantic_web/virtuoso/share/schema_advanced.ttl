@prefix img: <http://progetto-dl-sw.org/images/> .
@prefix obj: <http://progetto-dl-sw.org/objects/> .
@prefix ont: <http://progetto-dl-sw.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Object Properties
#################################################################

###  http://progetto-dl-sw.org/ontology#above
ont:above rdf:type owl:ObjectProperty ;
          owl:inverseOf ont:below ,
                        ont:under ;
          rdf:type owl:AsymmetricProperty ,
                   owl:TransitiveProperty ,
                   owl:IrreflexiveProperty ;
          owl:propertyChainAxiom ( ont:lying_on
                                   ont:on
                                 ) ,
                                 ( ont:parked_on
                                   ont:on
                                 ) ,
                                 ( ont:sitting_on
                                   ont:on
                                 ) ,
                                 ( ont:standing_on
                                   ont:on
                                 ) ,
                                 ( ont:walking_on
                                   ont:on
                                 ) .


###  http://progetto-dl-sw.org/ontology#around
ont:around rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ont:near ;
           rdf:type owl:SymmetricProperty ,
                    owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#at
ont:at rdf:type owl:ObjectProperty ,
                owl:AsymmetricProperty ,
                owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#behind
ont:behind rdf:type owl:ObjectProperty ;
           owl:inverseOf ont:in_front_of ;
           rdf:type owl:AsymmetricProperty ,
                    owl:TransitiveProperty ,
                    owl:IrreflexiveProperty ;
           owl:propertyChainAxiom ( ont:in
                                    ont:behind
                                  ) ,
                                  ( ont:on
                                    ont:behind
                                  ) .


###  http://progetto-dl-sw.org/ontology#below
ont:below rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:TransitiveProperty ,
                   owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#beside
ont:beside rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ont:near ;
           rdf:type owl:SymmetricProperty ,
                    owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#by
ont:by rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf ont:near ;
       rdf:type owl:SymmetricProperty ,
                owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#carrying
ont:carrying rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#contain
ont:contain rdf:type owl:ObjectProperty ;
            owl:inverseOf ont:in ;
            rdf:type owl:AsymmetricProperty ,
                     owl:TransitiveProperty ,
                     owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#covered_by
ont:covered_by rdf:type owl:ObjectProperty ;
               owl:inverseOf ont:covering ;
               rdf:type owl:AsymmetricProperty ,
                        owl:TransitiveProperty ,
                        owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#covered_in
ont:covered_in rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:covered_by ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               owl:propertyChainAxiom ( ont:wearing
                                        ont:covered_in
                                      ) .


###  http://progetto-dl-sw.org/ontology#covered_with
ont:covered_with rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf ont:covered_by ;
                 rdf:type owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 owl:propertyChainAxiom ( ont:wearing
                                          ont:covered_with
                                        ) .


###  http://progetto-dl-sw.org/ontology#covering
ont:covering rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:TransitiveProperty ,
                      owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#crossing
ont:crossing rdf:type owl:ObjectProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] ;
             rdfs:range <http://example.invalid/ontologies/ont.owl#Location> .


###  http://progetto-dl-sw.org/ontology#driving_on
ont:driving_on rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:on ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain <http://example.invalid/ontologies/ont.owl#Vehicles> ;
               rdfs:range <http://example.invalid/ontologies/ont.owl#Location> .


###  http://progetto-dl-sw.org/ontology#eating
ont:eating rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
           rdfs:range <http://example.invalid/ontologies/ont.owl#Food> .


###  http://progetto-dl-sw.org/ontology#filled_with
ont:filled_with rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain <http://example.invalid/ontologies/ont.owl#InanimateObject> ;
                rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#InanimateObject>
                                            <http://example.invalid/ontologies/ont.owl#Substance>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#flying
ont:flying rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#flying_in
ont:flying_in rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf ont:in ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#full_of
ont:full_of rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain <http://example.invalid/ontologies/ont.owl#InanimateObject> ;
            rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#InanimateObject>
                                            <http://example.invalid/ontologies/ont.owl#Substance>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#hanging_from
ont:hanging_from rdf:type owl:ObjectProperty ,
                          owl:AsymmetricProperty ,
                          owl:TransitiveProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                              )
                                ] ;
                 rdfs:range <http://example.invalid/ontologies/ont.owl#Location> .


###  http://progetto-dl-sw.org/ontology#hanging_on
ont:hanging_on rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                              )
                                ] ;
               rdfs:range <http://example.invalid/ontologies/ont.owl#Location> .


###  http://progetto-dl-sw.org/ontology#hitting
ont:hitting rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf ont:touching ;
            rdf:type owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#SportsEquipment>
                                              )
                                ] ;
            rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#holding
ont:holding rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#in
ont:in rdf:type owl:ObjectProperty ,
                owl:AsymmetricProperty ,
                owl:TransitiveProperty ,
                owl:IrreflexiveProperty ;
       owl:propertyChainAxiom ( ont:flying_in
                                ont:in
                              ) ,
                              ( ont:lying_on
                                ont:in
                              ) ,
                              ( ont:parked_on
                                ont:in
                              ) ,
                              ( ont:sitting_on
                                ont:in
                              ) ,
                              ( ont:standing_on
                                ont:in
                              ) ,
                              ( ont:walking_in
                                ont:in
                              ) .


###  http://progetto-dl-sw.org/ontology#in_front_of
ont:in_front_of rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:TransitiveProperty ,
                         owl:IrreflexiveProperty ;
                owl:propertyChainAxiom ( ont:in
                                         ont:in_front_of
                                       ) ,
                                       ( ont:on
                                         ont:in_front_of
                                       ) .


###  http://progetto-dl-sw.org/ontology#inside
ont:inside rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ont:in ;
           rdf:type owl:AsymmetricProperty ,
                    owl:TransitiveProperty ,
                    owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#leaning_on
ont:leaning_on rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:touching ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#ArchitecturalStructure>
                                            <http://example.invalid/ontologies/ont.owl#FacilityElement>
                                            <http://example.invalid/ontologies/ont.owl#Furniture>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#looking_at
ont:looking_at rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               owl:propertyChainAxiom ( ont:riding
                                        ont:in_front_of
                                      ) ,
                                      ( ont:riding_on
                                        ont:in_front_of
                                      ) .


###  http://progetto-dl-sw.org/ontology#lying_in
ont:lying_in rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ont:in ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
             rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#lying_on
ont:lying_on rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ont:on ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
             rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#near
ont:near rdf:type owl:ObjectProperty ,
                  owl:SymmetricProperty ,
                  owl:IrreflexiveProperty ;
         owl:propertyChainAxiom ( ont:in
                                  ont:near
                                ) ,
                                ( ont:on
                                  ont:near
                                ) .


###  http://progetto-dl-sw.org/ontology#next_to
ont:next_to rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf ont:near ;
            rdf:type owl:SymmetricProperty ,
                     owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#of
ont:of rdf:type owl:ObjectProperty ,
                owl:AsymmetricProperty ,
                owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#on
ont:on rdf:type owl:ObjectProperty ,
                owl:AsymmetricProperty ,
                owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#on_the_back_of
ont:on_the_back_of rdf:type owl:ObjectProperty ;
                   owl:inverseOf ont:on_the_front_of ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#on_the_front_of
ont:on_the_front_of rdf:type owl:ObjectProperty ,
                             owl:AsymmetricProperty ,
                             owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#on_the_side_of
ont:on_the_side_of rdf:type owl:ObjectProperty ,
                            owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#on_top_of
ont:on_top_of rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf ont:on ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#parked_on
ont:parked_on rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf ont:on ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain <http://example.invalid/ontologies/ont.owl#Vehicles> ;
              rdfs:range <http://example.invalid/ontologies/ont.owl#Location> .


###  http://progetto-dl-sw.org/ontology#playing_with
ont:playing_with rdf:type owl:ObjectProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#pulled_by
ont:pulled_by rdf:type owl:ObjectProperty ;
              owl:inverseOf ont:pulling ;
              rdf:type owl:AsymmetricProperty ,
                       owl:TransitiveProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] ;
              rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#pulling
ont:pulling rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:TransitiveProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] ;
            rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#reflected_in
ont:reflected_in rdf:type owl:ObjectProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#riding
ont:riding rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain <http://example.invalid/ontologies/ont.owl#Person> ;
           rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#riding_on
ont:riding_on rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf ont:on ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain <http://example.invalid/ontologies/ont.owl#Person> ;
              rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Person>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#sitting_at
ont:sitting_at rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#sitting_in
ont:sitting_in rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:in ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#sitting_on
ont:sitting_on rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:on ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                            <http://example.invalid/ontologies/ont.owl#Vehicles>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#standing_by
ont:standing_by rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf ont:near ;
                rdf:type owl:SymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#standing_in
ont:standing_in rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf ont:in ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
                rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#standing_next_to
ont:standing_next_to rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ont:near ;
                     rdf:type owl:SymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#standing_on
ont:standing_on rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf ont:on ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
                rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#surrounded_by
ont:surrounded_by rdf:type owl:ObjectProperty ,
                           owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#swinging
ont:swinging rdf:type owl:ObjectProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
             rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Item>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#to_the_left_of
ont:to_the_left_of rdf:type owl:ObjectProperty ;
                   owl:inverseOf ont:to_the_right_of ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:TransitiveProperty ,
                            owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#to_the_right_of
ont:to_the_right_of rdf:type owl:ObjectProperty ,
                             owl:AsymmetricProperty ,
                             owl:TransitiveProperty ,
                             owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#touching
ont:touching rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ,
                      owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#under
ont:under rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:TransitiveProperty ,
                   owl:IrreflexiveProperty .


###  http://progetto-dl-sw.org/ontology#using
ont:using rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain <http://example.invalid/ontologies/ont.owl#Person> .


###  http://progetto-dl-sw.org/ontology#walking_in
ont:walking_in rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:in ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#walking_on
ont:walking_on rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ont:on ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] ;
               rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Furniture>
                                            <http://example.invalid/ontologies/ont.owl#Location>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#watching
ont:watching rdf:type owl:ObjectProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://example.invalid/ontologies/ont.owl#Animals>
                                            <http://example.invalid/ontologies/ont.owl#Person>
                                              )
                                ] .


###  http://progetto-dl-sw.org/ontology#wearing
ont:wearing rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain <http://example.invalid/ontologies/ont.owl#Person> ;
            rdfs:range <http://example.invalid/ontologies/ont.owl#Clothing> .


###  http://progetto-dl-sw.org/ontology#with
ont:with rdf:type owl:ObjectProperty ,
                  owl:TransitiveProperty ,
                  owl:IrreflexiveProperty .


